datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

model Movie {
  id             String   @id @default(uuid())
  title          String   @unique
  releaseYear    Int
  runtimeMinutes Int
  watched        Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Self-referencing many-to-many relationship:
  // Movies that must be watched before this movie
  prerequisites   Movie[]  @relation("MoviePrerequisites")

  // Movies that require this movie as a prerequisite
  prerequisiteFor Movie[]  @relation("MoviePrerequisites")
}

model Cinema {
  id          String   @id @default(uuid())
  name        String   @unique
  bundleSizes Int[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
